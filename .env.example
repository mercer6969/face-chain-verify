# Copy this file to .env and fill in real values.

# --- Step 2: Reverse image search ---
# Free key from https://serpapi.com/ (100 free searches/month on the free tier)
SERPAPI_API_KEY=

# --- Step 4: Blockchain connection ---
# "local" = in-process simulated EVM chain (eth-tester), no setup required.
# "rpc"   = connect to a real node: a local Anvil/Hardhat node, or a public
#           testnet like Sepolia / Polygon Amoy.
CHAIN_MODE=local

# Only needed when CHAIN_MODE=rpc:
RPC_URL=
PRIVATE_KEY=

# Optional: reuse an already-deployed EvidenceRegistry instead of redeploying
# a fresh one on every run.
CONTRACT_ADDRESS=
